@code{ck803ftr1},
@code{ck803eftr1},
@code{ck803efhtr1},
@code{ck803r2},
@code{ck803vr2},
@code{ck803hr2},
@code{ck803tr2},
@code{ck803htr2},
@code{ck803fr2},
